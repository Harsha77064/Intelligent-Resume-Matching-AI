# Copy to backend/.env and adjust. Real environment variables override this file.

# 0 = no demo jobs/resumes/accounts (use this for real users)
SEED_DEMO=1

# Optional: signs login sessions. If unset, a random key is generated in data/secret.key
# SECRET_KEY=

# Optional: create the first HR account automatically on startup
# HR_EMAIL=you@company.com
# HR_PASSWORD=
# HR_NAME=Your Name

# Optional: email for "Forgot password" codes. Without SMTP_HOST the code is printed
# in the server console (development only). Gmail: turn on 2-Step Verification, then
# create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=MatchPoint <yourname@gmail.com>
